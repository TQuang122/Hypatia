# Optional runtime defaults for Hypatia.
# Provider credentials are read by pi-coding-agent in the usual ways.

HYPATIA_MODEL=
HYPATIA_THINKING=medium
# Optional override for PDF scratch Markdown written by fetch_content.
# Default: <project>/.hypatia/cache/fetch-content
HYPATIA_FETCH_CACHE_DIR=
# Telemetry is off by default. Set HYPATIA_TELEMETRY=1 to opt in to anonymous
# usage telemetry, plus your own PostHog project below (never Companion's).
HYPATIA_TELEMETRY=
HYPATIA_POSTHOG_HOST=https://us.i.posthog.com
HYPATIA_POSTHOG_PROJECT_ID=
HYPATIA_POSTHOG_KEY=
# Cap top-level tool calls per session; the call past the budget is blocked
# with a reason. Unset means unlimited.
HYPATIA_TOOL_BUDGET=
# Set to 1 to register the Context7 MCP server (versioned library docs via
# npx) for replication and ML-recipe runs.
HYPATIA_CONTEXT7=
# Optional local Kev advisory tool. Off unless explicitly set to 1.
HYPATIA_KEV_ENABLED=
HYPATIA_KEV_URL=http://127.0.0.1:8008
HYPATIA_KEV_MODEL=kev-latest
HYPATIA_KEV_TIMEOUT_MS=2000
HYPATIA_KEV_CONCURRENCY=4
KEV_API_KEY=
# Optional local AutoResearch checkout for verified idea-file imports.
HYPATIA_AUTORESEARCH_ROOT=
# Hypatia's bundled pi-otel extension sends gen_ai.* Pi/plugin spans to PostHog AI Observability
# without prompt or tool payload content. CLI spans/logs use PostHog distributed tracing/logs.
PI_OTEL_CAPTURE_CONTENT=metadata_only

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
AZURE_OPENAI_API_KEY=

RUNPOD_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Raises the NCBI E-utilities limit from 3 to 10 requests/sec.
NCBI_API_KEY=
# Optional minimum delay between NCBI request starts (500ms anonymous, 125ms keyed).
NCBI_MIN_REQUEST_GAP_MS=
